# Required in Vercel for the Meta Ads dashboard APIs.
# Use a production Postgres URL. Do not use the local brunonikel@localhost URL in Vercel.
DATABASE_URL=

# Optional locally only. Not needed in Vercel.
SQLITE_DB_PATH=

# Required in Vercel for /materiais view/download buttons.
# Cloudflare R2 S3-compatible credentials.
R2_ACCOUNT_ID=d00730b1a6b727069dc485d8018b018c
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=business-hub-materials

# Optional in Vercel: set only when using a public/custom R2 domain.
# If blank, the app generates short-lived signed URLs server-side.
R2_PUBLIC_BASE_URL=
